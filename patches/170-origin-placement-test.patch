+	return PageScanRaw((Brother_Scanner *)context, buffer, capacity, length);
+}
+
+int
+PageScan(Brother_Scanner *this, char *buffer, int capacity, int *length)
+{
+	if (!scan_origin.enabled || this->scanState.bCanceled)
