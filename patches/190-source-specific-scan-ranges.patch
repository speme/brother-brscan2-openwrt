+/* QueryDeviceInfo() fills these limits from the scanner I-command. */
+static void
+UpdateScanAreaRanges (Brother_Scanner *this, int source)
+{
+  double width_mm;
+  double height_mm;
+
+  width_mm = this->devScanInfo.dwMaxScanWidth > 0 ?
+    this->devScanInfo.dwMaxScanWidth / 10.0 :
+    this->modelConfig.SupportScanAreaWidth;
+
+  if (source == SCANSRC_FB && this->devScanInfo.dwMaxScanHeight > 0)
+    height_mm = this->devScanInfo.dwMaxScanHeight / 10.0;
+  else
+    height_mm = this->modelConfig.SupportScanAreaHeight;
+
+  this->scanRangeXmm.min = SANE_FIX(0.0);
+  this->scanRangeXmm.max = SANE_FIX(width_mm);
+  this->scanRangeXmm.quant = SANE_FIX(0.1);
+  this->scanRangeYmm.min = SANE_FIX(0.0);
+  this->scanRangeYmm.max = SANE_FIX(height_mm);
+  this->scanRangeYmm.quant = SANE_FIX(0.1);
+}
