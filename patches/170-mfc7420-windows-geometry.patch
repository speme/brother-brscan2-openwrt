--- a/brscan/backend_src/brother_scanner.c
+++ b/brscan/backend_src/brother_scanner.c
@@ -35,5 +35,9 @@
 #include <usb.h>
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
 #include "sane/sane.h"
 
 #include "brother_dtype.h"
@@ -1823,6 +1827,69 @@ GetScanAreaParam( Brother_Scanner *this )
 	this->scanInfo.ScanAreaMm = this->uiSetting.ScanAreaMm;
+	/*
+	 * Port the MFC-7420 values and coordinate mapping from its Windows TWAIN
+	 * model file. Values are thousandths of an inch. For the flatbed, the
+	 * Windows calculation keeps the calibrated start at zero and trims the
+	 * far edge by ScanOrigin + Margin. Apply in 0.1 mm units before converting
+	 * to dots so SANE frame dimensions and USB A= coordinates stay consistent.
+	 */
+	if (this->modelInf.productID == 0x0180 &&
+	    this->devScanInfo.wScanSource == MFCSCANSRC_FB &&
+	    this->scanInfo.ScanAreaMm.left == 0 && this->scanInfo.ScanAreaMm.top == 0) {
+		LONG scan_origin_x = 77, scan_origin_y = 118;
+		LONG left_margin = 0, top_margin = 118;
+		LONG max_scan_width = 8347, max_scan_height = 13780;
+		LONG right_offset, bottom_offset, left_offset, top_offset;
+		LONG max_width, max_height;
+		FILE *geometry = fopen("/etc/sane.d/brother2-geometry.conf", "r");
+		char line[128];
+		if (geometry) {
+			while (fgets(line, sizeof(line), geometry)) {
+				char *eq = strchr(line, '=');
+				char *end;
+				long value;
+				if (!eq) continue;
+				*eq++ = '\0';
+				value = strtol(eq, &end, 10);
+				if (end == eq || value < 0 || value > 50000) continue;
+				if (!strcmp(line, "ScanOriginX")) scan_origin_x = value;
+				else if (!strcmp(line, "ScanOriginY")) scan_origin_y = value;
+				else if (!strcmp(line, "LeftMargin")) left_margin = value;
+				else if (!strcmp(line, "TopMargin")) top_margin = value;
+				else if (!strcmp(line, "MaxScanWidth")) max_scan_width = value;
+				else if (!strcmp(line, "MaxScanHeight")) max_scan_height = value;
+			}
+			fclose(geometry);
+		}
+		/* 1 thou = 0.254 units of 0.1 mm; round to the nearest unit. */
+		max_width = (max_scan_width * 254L + 500L) / 1000L;
+		max_height = (max_scan_height * 254L + 500L) / 1000L;
+		if (this->scanInfo.ScanAreaMm.right > max_width)
+			this->scanInfo.ScanAreaMm.right = max_width;
+		if (this->scanInfo.ScanAreaMm.bottom > max_height)
+			this->scanInfo.ScanAreaMm.bottom = max_height;
+		right_offset = ((scan_origin_x + left_margin) * 254L + 500L) / 1000L;
+		bottom_offset = ((scan_origin_y + top_margin) * 254L + 500L) / 1000L;
+		left_offset = left_margin > scan_origin_x ?
+			((left_margin - scan_origin_x) * 254L + 500L) / 1000L : 0;
+		top_offset = top_margin > scan_origin_y ?
+			((top_margin - scan_origin_y) * 254L + 500L) / 1000L : 0;
+		this->scanInfo.ScanAreaMm.left += left_offset;
+		this->scanInfo.ScanAreaMm.top += top_offset;
+		if (this->scanInfo.ScanAreaMm.right > right_offset)
+			this->scanInfo.ScanAreaMm.right -= right_offset;
+		else
+			this->scanInfo.ScanAreaMm.right = this->scanInfo.ScanAreaMm.left;
+		if (this->scanInfo.ScanAreaMm.bottom > bottom_offset)
+			this->scanInfo.ScanAreaMm.bottom -= bottom_offset;
+		else
+			this->scanInfo.ScanAreaMm.bottom = this->scanInfo.ScanAreaMm.top;
+		fprintf(stderr, "brother2 MFC-7420 TWAIN geometry: cap=%ld,%ld offsets=%ld,%ld area=%ld,%ld,%ld,%ld\n",
+		        (long)max_width, (long)max_height, (long)right_offset, (long)bottom_offset,
+		        (long)this->scanInfo.ScanAreaMm.left, (long)this->scanInfo.ScanAreaMm.top,
+		        (long)this->scanInfo.ScanAreaMm.right, (long)this->scanInfo.ScanAreaMm.bottom);
+	}
 
 	//
 	// exchange the scan-area-coordinates form  0.1mm unit to pixel unit.
